# Copy this file to .env and fill in the values. NEVER commit .env to git.

# Token from @BotFather
BOT_TOKEN=put-your-bot-token-here

# Telegram user IDs of presidential team members who receive messages (comma separated)
ADMIN_IDS=7517585192

# Optional settings
TEAM_NAME=Presidential Team
SCHOOL_NAME=MUSS
DB_PATH=bot.db
# After this many days the private "reply route" between a ticket and a student's chat is deleted
ROUTE_RETENTION_DAYS=60
